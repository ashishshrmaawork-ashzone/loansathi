{
  "name": "loan-sathi-mern",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "concurrently -k -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm run start --workspace api",
    "start:web": "npm run start --workspace web",
    "test": "npm run test --workspace api",
    "migrate:sqlite": "npm run migrate:sqlite --workspace api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
